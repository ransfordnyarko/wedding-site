# Copy to .env.local and fill in (Supabase → Project Settings → API).

# Browser (safe to expose; read-only through RLS)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server only (used by /api; never prefix with VITE_)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
# Optional: signs upload sessions and hashes IPs. Defaults to the service-role key.
UPLOAD_TOKEN_SECRET=

# RSVP form → Google Sheet. The Apps Script web app URL (ends in /exec).
# Setup steps: google-apps-script/rsvp.gs
VITE_RSVP_SHEET_URL=
